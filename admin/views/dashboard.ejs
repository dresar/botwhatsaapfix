<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel - WhatsApp Bot</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">

</head>
<body>
  <button class="btn btn-sm btn-dark toggle-sidebar" id="sidebarToggle">
    <i class="bi bi-list"></i>
  </button>

  <!-- Sidebar -->
  <div class="sidebar" id="sidebar">
    <div class="sidebar-header">
      <img src="/images/whatsapp-logo.svg" alt="WhatsApp Bot Logo" onerror="this.src='https://via.placeholder.com/60x60?text=WA+Bot'">
      <h3>WhatsApp Bot</h3>
      <p>Admin Panel</p>
    </div>
    <ul class="nav flex-column">
      <li class="nav-item">
        <a class="nav-link active" href="#dashboard" data-bs-toggle="tab">
          <i class="bi bi-speedometer2"></i> Dashboard
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="#bot-control" data-bs-toggle="tab">
          <i class="bi bi-robot"></i> Kontrol Bot
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="#features" data-bs-toggle="tab">
          <i class="bi bi-toggles"></i> Fitur
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="#qr-code" data-bs-toggle="tab">
          <i class="bi bi-qr-code"></i> QR Code
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="#logs" data-bs-toggle="tab">
          <i class="bi bi-journal-text"></i> Log
        </a>
      </li>
      <li class="nav-item mt-5">
        <a class="nav-link" href="/logout">
          <i class="bi bi-box-arrow-right"></i> Logout
        </a>
      </li>
    </ul>
  </div>

  <!-- Content -->
  <div class="main-content">
    <div class="container-fluid">
      <div class="tab-content">
        <!-- Dashboard Tab -->
        <div class="tab-pane fade show active" id="dashboard">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Dashboard</h2>
            <span>Selamat datang, <%= username %></span>
          </div>
          
          <div class="row">
            <div class="col-md-6">
              <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                  <span>Status Bot</span>
                  <button class="btn btn-sm btn-outline-primary" onclick="window.location.reload()">
                    <i class="bi bi-arrow-clockwise"></i> Refresh
                  </button>
                </div>
                <div class="card-body">
                  <h5>
                    <span class="status-indicator <%= botStatus.running ? 'active' : 'inactive' %>"></span>
                    Bot Status: <%= botStatus.running ? 'Aktif' : 'Tidak Aktif' %>
                  </h5>
                  <p><strong>Restart Terakhir:</strong> <%= botStatus.lastRestart %></p>
                  <p><strong>Uptime:</strong> <%= botStatus.uptime %></p>
                  <p><strong>Penggunaan Memori:</strong> <%= botStatus.memory %></p>
                  <p><strong>Penggunaan CPU:</strong> <%= botStatus.cpu %></p>
                  <p><strong>Jumlah Restart:</strong> <%= botStatus.restarts %></p>
                  <p><strong>Terakhir Diperbarui:</strong> <%= botStatus.lastUpdate %></p>
                </div>
              </div>
              
              <div class="card">
                <div class="card-header">Informasi Sistem</div>
                <div class="card-body">
                  <p><strong>Platform:</strong> <%= systemInfo.platform %></p>
                  <p><strong>Arsitektur:</strong> <%= systemInfo.arch %></p>
                  <p><strong>Node.js Version:</strong> <%= systemInfo.nodeVersion %></p>
                  <p><strong>Penggunaan Memori:</strong> <%= systemInfo.memory %></p>
                  <p><strong>Penggunaan CPU:</strong> <%= systemInfo.cpu %></p>
                  <p><strong>Uptime Sistem:</strong> <%= systemInfo.uptime %></p>
                </div>
              </div>
            </div>
            
            <div class="col-md-6">
              <div class="card">
                <div class="card-header">Status Fitur</div>
                <div class="card-body">
                  <div class="row">
                    <div class="col-md-6">
                      <p>
                        <i class="bi <%= featureStatus.ai ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger' %>"></i>
                        AI: <%= featureStatus.ai ? 'Aktif' : 'Nonaktif' %>
                      </p>
                      <p>
                        <i class="bi <%= featureStatus.drive ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger' %>"></i>
                        Google Drive: <%= featureStatus.drive ? 'Aktif' : 'Nonaktif' %>
                      </p>
                      <p>
                        <i class="bi <%= featureStatus.keep ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger' %>"></i>
                        Google Keep: <%= featureStatus.keep ? 'Aktif' : 'Nonaktif' %>
                      </p>
                      <p>
                        <i class="bi <%= featureStatus.sqliteLogging ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger' %>"></i>
                        SQLite Logging: <%= featureStatus.sqliteLogging ? 'Aktif' : 'Nonaktif' %>
                      </p>
                    </div>
                    <div class="col-md-6">
                      <p>
                        <i class="bi <%= featureStatus.docs ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger' %>"></i>
                        Google Docs: <%= featureStatus.docs ? 'Aktif' : 'Nonaktif' %>
                      </p>
                      <p>
                        <i class="bi <%= featureStatus.calendar ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger' %>"></i>
                        Google Calendar: <%= featureStatus.calendar ? 'Aktif' : 'Nonaktif' %>
                      </p>
                      <p>
                        <i class="bi <%= featureStatus.tasks ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger' %>"></i>
                        Google Tasks: <%= featureStatus.tasks ? 'Aktif' : 'Nonaktif' %>
                      </p>
                      <p>
                        <i class="bi <%= featureStatus.wikipedia ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger' %>"></i>
                        Wikipedia: <%= featureStatus.wikipedia ? 'Aktif' : 'Nonaktif' %>
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Bot Control Tab -->
        <div class="tab-pane fade" id="bot-control">
          <h2 class="mb-4">Kontrol Bot</h2>
          
          <div class="card">
            <div class="card-header">Manajemen Bot</div>
            <div class="card-body">
              <div class="d-flex gap-2">
                <button id="startBot" class="btn btn-success">
                  <i class="bi bi-play-fill"></i> Mulai Bot
                </button>
                <button id="stopBot" class="btn btn-danger">
                  <i class="bi bi-stop-fill"></i> Hentikan Bot
                </button>
                <button id="restartBot" class="btn btn-warning">
                  <i class="bi bi-arrow-clockwise"></i> Restart Bot
                </button>
              </div>
              
              <div class="mt-3" id="botActionResult"></div>
            </div>
          </div>
        </div>
        
        <!-- Features Tab -->
        <div class="tab-pane fade" id="features">
          <h2 class="mb-4">Pengaturan Fitur</h2>
          
          <div class="card">
            <div class="card-header">Aktifkan/Nonaktifkan Fitur</div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-6">
                  <div class="form-check form-switch mb-3">
                    <input class="form-check-input feature-toggle" type="checkbox" id="aiToggle" <%= featureStatus.ai ? 'checked' : '' %> data-feature="ai">
                    <label class="form-check-label" for="aiToggle">AI</label>
                  </div>
                  <div class="form-check form-switch mb-3">
                    <input class="form-check-input feature-toggle" type="checkbox" id="driveToggle" <%= featureStatus.drive ? 'checked' : '' %> data-feature="drive">
                    <label class="form-check-label" for="driveToggle">Google Drive</label>
                  </div>
                  <div class="form-check form-switch mb-3">
                    <input class="form-check-input feature-toggle" type="checkbox" id="keepToggle" <%= featureStatus.keep ? 'checked' : '' %> data-feature="keep">
                    <label class="form-check-label" for="keepToggle">Google Keep</label>
                  </div>
                  <div class="form-check form-switch mb-3">
                    <input class="form-check-input feature-toggle" type="checkbox" id="sqliteLoggingToggle" <%= featureStatus.sqliteLogging ? 'checked' : '' %> data-feature="sqliteLogging">
                    <label class="form-check-label" for="sqliteLoggingToggle">SQLite Logging</label>
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="form-check form-switch mb-3">
                    <input class="form-check-input feature-toggle" type="checkbox" id="docsToggle" <%= featureStatus.docs ? 'checked' : '' %> data-feature="docs">
                    <label class="form-check-label" for="docsToggle">Google Docs</label>
                  </div>
                  <div class="form-check form-switch mb-3">
                    <input class="form-check-input feature-toggle" type="checkbox" id="calendarToggle" <%= featureStatus.calendar ? 'checked' : '' %> data-feature="calendar">
                    <label class="form-check-label" for="calendarToggle">Google Calendar</label>
                  </div>
                  <div class="form-check form-switch mb-3">
                    <input class="form-check-input feature-toggle" type="checkbox" id="tasksToggle" <%= featureStatus.tasks ? 'checked' : '' %> data-feature="tasks">
                    <label class="form-check-label" for="tasksToggle">Google Tasks</label>
                  </div>
                  <div class="form-check form-switch mb-3">
                    <input class="form-check-input feature-toggle" type="checkbox" id="wikipediaToggle" <%= featureStatus.wikipedia ? 'checked' : '' %> data-feature="wikipedia">
                    <label class="form-check-label" for="wikipediaToggle">Wikipedia</label>
                  </div>
                </div>
              </div>
              
              <div class="mt-3" id="featureToggleResult"></div>
            </div>
          </div>
        </div>
        
        <!-- QR Code Tab -->
        <div class="tab-pane fade" id="qr-code">
          <h2 class="mb-4">QR Code WhatsApp</h2>
          
          <div class="card">
            <div class="card-header">Scan QR Code untuk Login WhatsApp</div>
            <div class="card-body">
              <% if (qrCodeExists) { %>
                <div class="qr-container">
                  <img src="/temp/last-qr.png" alt="WhatsApp QR Code" class="img-fluid">
                  <p class="mt-3">Scan QR code ini dengan WhatsApp di ponsel Anda untuk login.</p>
                  <p class="text-muted">QR code ini akan kedaluwarsa setelah beberapa saat. Jika sudah kedaluwarsa, restart bot untuk mendapatkan QR code baru.</p>
                </div>
              <% } else { %>
                <div class="text-center py-4">
                  <p>QR code tidak tersedia. Restart bot untuk mendapatkan QR code baru.</p>
                  <button id="restartForQR" class="btn btn-primary mt-2">
                    <i class="bi bi-arrow-clockwise"></i> Restart Bot untuk QR Code
                  </button>
                </div>
              <% } %>
            </div>
          </div>
        </div>
        
        <!-- Logs Tab -->
        <div class="tab-pane fade" id="logs">
          <h2 class="mb-4">Log Bot</h2>
          
          <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
              <span>Log Bot</span>
              <div>
                <select id="logType" class="form-select form-select-sm d-inline-block w-auto me-2">
                  <option value="out">Output Log</option>
                  <option value="error">Error Log</option>
                </select>
                <button id="refreshLogs" class="btn btn-sm btn-outline-primary">
                  <i class="bi bi-arrow-clockwise"></i> Refresh
                </button>
              </div>
            </div>
            <div class="card-body">
              <div class="log-container" id="logContent">
                Loading logs...
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/admin.js"></script>
</body>
</html>