<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QR Code - WhatsApp Bot Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container-fluid">
    <div class="row">
      <!-- Sidebar -->
      <nav id="sidebar" class="col-md-3 col-lg-2 d-md-block bg-dark sidebar">
        <div class="position-sticky">
          <div class="sidebar-header">
            <img src="/images/logo.svg" alt="Logo" class="sidebar-logo">
            <h3 class="sidebar-title">WhatsApp Bot</h3>
          </div>
          <ul class="nav flex-column">
            <li class="nav-item">
              <a class="nav-link" href="/">
                <i class="bi bi-speedometer2"></i> Dashboard
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/#bot-control">
                <i class="bi bi-power"></i> Kontrol Bot
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/#features">
                <i class="bi bi-toggles"></i> Fitur
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link active" href="/qrcode">
                <i class="bi bi-qr-code"></i> QR Code
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/logs">
                <i class="bi bi-journal-text"></i> Log
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/settings">
                <i class="bi bi-gear"></i> Pengaturan
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/logout">
                <i class="bi bi-box-arrow-right"></i> Logout
              </a>
            </li>
          </ul>
        </div>
      </nav>

      <!-- Main content -->
      <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
          <h1 class="h2">QR Code WhatsApp</h1>
          <div class="btn-toolbar mb-2 mb-md-0">
            <button type="button" class="btn btn-sm btn-outline-secondary d-md-none" id="sidebarToggle">
              <i class="bi bi-list"></i>
            </button>
          </div>
        </div>

        <div class="row">
          <div class="col-md-8">
            <div class="card mb-4">
              <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">QR Code untuk Login WhatsApp</h5>
                <button class="btn btn-sm btn-primary" id="refreshQrCode">
                  <i class="bi bi-arrow-clockwise"></i> Refresh
                </button>
              </div>
              <div class="card-body text-center">
                <div id="qrCodeContainer">
                  <% if (qrCodeExists) { %>
                    <img src="/qrcode/image" alt="WhatsApp QR Code" class="img-fluid qr-code-image">
                    <p class="mt-3">Scan QR code ini dengan aplikasi WhatsApp di ponsel Anda untuk login.</p>
                  <% } else { %>
                    <div class="alert alert-warning">
                      <i class="bi bi-exclamation-triangle"></i> QR code tidak tersedia.
                      <p>Untuk mendapatkan QR code baru, restart bot dari halaman Dashboard.</p>
                    </div>
                    <a href="/#bot-control" class="btn btn-primary">
                      <i class="bi bi-arrow-clockwise"></i> Restart Bot
                    </a>
                  <% } %>
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-4">
            <div class="card mb-4">
              <div class="card-header">
                <h5 class="card-title mb-0">Petunjuk</h5>
              </div>
              <div class="card-body">
                <ol>
                  <li>Buka aplikasi WhatsApp di ponsel Anda.</li>
                  <li>Ketuk Menu (tiga titik) atau Pengaturan.</li>
                  <li>Pilih WhatsApp Web atau Perangkat Tertaut.</li>
                  <li>Ketuk Tautkan Perangkat.</li>
                  <li>Arahkan kamera ponsel ke QR code di layar ini.</li>
                </ol>
                <div class="alert alert-info">
                  <i class="bi bi-info-circle"></i> QR code akan kedaluwarsa setelah beberapa saat. Jika QR code tidak berfungsi, restart bot untuk mendapatkan QR code baru.
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/admin.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Refresh QR code
      const refreshQrCodeBtn = document.getElementById('refreshQrCode');
      if (refreshQrCodeBtn) {
        refreshQrCodeBtn.addEventListener('click', function() {
          const qrCodeImage = document.querySelector('.qr-code-image');
          if (qrCodeImage) {
            // Add timestamp to prevent caching
            qrCodeImage.src = '/qrcode/image?t=' + new Date().getTime();
          } else {
            // Reload the page to check if QR code is available
            window.location.reload();
          }
        });
      }

      // Check QR code status every 30 seconds
      setInterval(function() {
        fetch('/api/qrcode/status')
          .then(response => response.json())
          .then(data => {
            const qrCodeContainer = document.getElementById('qrCodeContainer');
            if (data.exists) {
              if (!document.querySelector('.qr-code-image')) {
                // QR code exists but not shown, reload the page
                window.location.reload();
              }
            } else {
              if (document.querySelector('.qr-code-image')) {
                // QR code shown but doesn't exist anymore, reload the page
                window.location.reload();
              }
            }
          })
          .catch(error => console.error('Error checking QR code status:', error));
      }, 30000);
    });
  </script>
</body>
</html>